# Sport Kick - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ==================== SUPABASE CONFIGURATION ====================
# Get these values from your Supabase project dashboard
# Project Settings > API > Project URL and API Keys

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (safe to use in client-side code)
# This key has Row Level Security (RLS) restrictions
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key (admin access)
# WARNING: Keep this secret! Only use server-side
# Has full access to bypass RLS policies
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ==================== FIREBASE CONFIGURATION (Optional) ====================
# If using Firebase for analytics, crashlytics, or notifications
# Get these from Firebase Console > Project Settings

# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_APP_ID=your-app-id

# ==================== GOOGLE MAPS (Optional) ====================
# For location features and map display
# Get from Google Cloud Console > APIs & Services > Credentials

# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ==================== PAYMENT GATEWAY (Optional) ====================
# For payment processing features

# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# STRIPE_SECRET_KEY=your-stripe-secret-key

# ==================== OTHER SERVICES (Optional) ====================

# Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn

# OneSignal for push notifications
# ONESIGNAL_APP_ID=your-onesignal-app-id
