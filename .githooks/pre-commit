#!/bin/sh
# Pre-commit hook for Flutter code quality checks

echo "🔍 Running pre-commit checks..."

# Check if dart is installed
if ! command -v dart &> /dev/null; then
    echo "❌ Dart is not installed or not in PATH"
    exit 1
fi

# Run dart format check (flutter format is deprecated)
echo "📝 Checking code formatting..."
if ! dart format --set-exit-if-changed . > /dev/null 2>&1; then
    echo "❌ Code formatting issues found. Run 'dart format .' to fix."
    exit 1
fi

# Run flutter analyze
echo "🔬 Running static analysis..."
if ! flutter analyze --no-fatal-infos; then
    echo "❌ Analysis issues found. Please fix before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed!"
exit 0

