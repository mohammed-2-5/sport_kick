#!/bin/sh
# Pre-commit hook for Flutter code quality checks

echo "🔍 Running pre-commit checks..."

# Check if flutter is installed
if ! command -v flutter &> /dev/null; then
    echo "❌ Flutter is not installed or not in PATH"
    exit 1
fi

# Run flutter format check
echo "📝 Checking code formatting..."
if ! flutter format --set-exit-if-changed .; then
    echo "❌ Code formatting issues found. Run 'flutter format .' to fix."
    exit 1
fi

# Run flutter analyze
echo "🔬 Running static analysis..."
if ! flutter analyze; then
    echo "❌ Analysis issues found. Please fix before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed!"
exit 0
